generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key       String   @id @db.VarChar(50)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

model Role {
  id Int @id @default(autoincrement())
  name String @unique

  invitationCodes InvitationCode[]
  users User[]

  @@map("roles")
}

model InvitationCode{
  id  Int @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  roleId    Int      @map("role_id")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  role      Role     @relation(fields: [roleId], references: [id])

  @@map("invitation_codes")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @map("name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  identifier       String?  @unique @db.VarChar(20)
  roleId           Int      @map("role_id")
  isActive         Boolean  @default(true) @map("is_active")
  resetTokenHash   String?  @map("reset_token_hash") @db.Text
  resetTokenExpires DateTime? @map("reset_token_expires") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  role         Role     @relation(fields: [roleId], references: [id])
  subjectsTaught Subject[]  @relation("ProfessorSubjects")
  enrollments    Enrollment[]
  submissions    Submission[]

  activities     Activity[]   @relation("ProfessorActivities")

  @@map("users")
}

model ProgrammingLanguage {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  editorIdentifier String @map("editor_identifier") @db.VarChar(50)
  version     String   @db.VarChar(20)
  dockerImage String   @map("docker_image") @db.VarChar(255)
  executionCommand String   @map("execution_command") @db.VarChar(255)
  fileExtension    String   @map("file_extension") @db.VarChar(10)
  activities       Activity[]
  submissions      Submission[]

  @@unique([name, version])
  @@map("programming_languages")
}

model Subject {
  id        Int        @id @default(autoincrement())
  userId    String     @map("user_id") @db.Uuid
  name      String     @db.Text
  imageUrl  String?    @map("image_url") @db.VarChar(500)

  activities Activity[]
  enrollments Enrollment[]
  professor  User         @relation("ProfessorSubjects", fields: [userId], references: [id])

  @@map("subjects")
}

model Enrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  subjectId  Int      @map("subject_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@map("enrollments")
}

model Activity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId  String   @map("professor_id") @db.Uuid
  languageId   Int      @map("language_id")
  subjectId    Int      @map("subject_id")
  title        String   @db.VarChar(200)
  description  String?  @db.Text
  starterCode  Json?    @map("starter_code")
  maxAttempts  Int      @default(0) @map("max_attempts")
  rules        Json?    @map("rules")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  professor    User                @relation("ProfessorActivities", fields: [professorId], references: [id])

  language    ProgrammingLanguage @relation(fields: [languageId], references: [id])
  subject     Subject             @relation(fields: [subjectId], references: [id])
  testCases   TestCase[]
  submissions Submission[]

  @@map("activities")
}

model TestCase {
  id             Int     @id @default(autoincrement())
  activityId     String  @map("activity_id") @db.Uuid
  input          String? @db.Text
  expectedOutput String  @map("expected_output") @db.Text
  isHidden       Boolean @default(false) @map("is_hidden")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Submission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  activityId      String   @map("activity_id") @db.Uuid
  languageId      Int      @map("language_id")
  codeSnapshot    Json     @map("code_snapshot")
  finalGrade      Decimal? @map("final_grade") @db.Decimal(5, 2)
  passedTests     Int      @default(0) @map("passed_tests")
  totalTests      Int      @default(0) @map("total_tests")
  executionTimeMs Int?     @map("execution_time_ms")
  status          String   @db.VarChar(50)
  compilerOutput  String?  @map("compiler_output") @db.Text
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  student   User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity  Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  language  ProgrammingLanguage @relation(fields: [languageId], references: [id])

  // Índice compuesto para que validar el límite de intentos sea ultrarrápido (Index Scan)
  @@index([studentId, activityId])
  @@map("submissions")
}

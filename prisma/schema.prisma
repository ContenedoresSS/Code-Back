generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id Int @id @default(autoincrement())
  name String @unique

  invitationCodes InvitationCode[]
  users User[]

  @@map("roles")
}

model InvitationCode{
  id  Int @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  roleId    Int      @map("role_id")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  role      Role     @relation(fields: [roleId], references: [id])

  @@map("invitation_codes")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @map("name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  identifier   String?  @unique @db.VarChar(20)
  roleId       Int      @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role         Role     @relation(fields: [roleId], references: [id])
  subjectsTaught Subject[]  @relation("ProfessorSubjects")
  enrollments    Enrollment[]
  submissions    Submission[]

  activities     Activity[]   @relation("ProfessorActivities")

  @@map("users")
}

model ProgrammingLanguage {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  editorIdentifier String @map("editor_identifier") @db.VarChar(50)
  version     String   @db.VarChar(20)
  dockerImage String   @map("docker_image") @db.VarChar(255)
  executionCommand String   @map("execution_command") @db.VarChar(255)
  fileExtension    String   @map("file_extension") @db.VarChar(10)
  activities       Activity[]

  @@unique([name, version])
  @@map("programming_languages")
}

model Subject {
  id        Int        @id @default(autoincrement())
  userId    String     @map("user_id") @db.Uuid
  name      String     @db.Text

  activities Activity[]
  enrollments Enrollment[]
  professor  User         @relation("ProfessorSubjects", fields: [userId], references: [id])

  @@map("subjects")
}

model Enrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  subjectId  Int      @map("subject_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@map("enrollments")
}

model Activity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professorId  String   @map("professor_id") @db.Uuid
  languageId   Int      @map("language_id")
  subjectId    Int      @map("subject_id")
  title        String   @db.VarChar(200)
  description  String?  @db.Text
  starterCode  Json?    @map("starter_code")
  maxAttempts  Int      @default(0) @map("max_attempts")
  allowCopy    Boolean  @default(true) @map("allow_copy")
  allowPaste   Boolean  @default(true) @map("allow_paste")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  professor    User                @relation("ProfessorActivities", fields: [professorId], references: [id])

  language    ProgrammingLanguage @relation(fields: [languageId], references: [id])
  subject     Subject             @relation(fields: [subjectId], references: [id])
  testCases   TestCase[]
  submissions Submission[]

  @@map("activities")
}

model TestCase {
  id             Int     @id @default(autoincrement())
  activityId     String  @map("activity_id") @db.Uuid
  input          String? @db.Text
  expectedOutput String  @map("expected_output") @db.Text
  isHidden       Boolean @default(false) @map("is_hidden")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Submission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  finalGrade     Decimal? @map("final_grade") @db.Decimal(5, 2)
  executionTimeMs Int?     @map("execution_time_ms")
  status         String   @db.VarChar(50) // Ej: "PENDING", "ACCEPTED", "WRONG_ANSWER", "TIME_LIMIT_EXCEEDED", "COMPILE_ERROR"
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  student  User     @relation(fields: [studentId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@map("submissions")
}

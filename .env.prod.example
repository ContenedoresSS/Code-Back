# ── Puerto del backend ──
PORT=5555
NODE_ENV=production

# ── Base de datos (PostgreSQL dentro del compose) ──
POSTGRES_USER=code_panel
POSTGRES_PASSWORD=<generar-con-openssl-rand-base64-32>
POSTGRES_DB=code_panel
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db_postgres:5432/${POSTGRES_DB}"

# ── CORS ──
CORS_ORIGINS="https://codepanel.orchfr.duckdns.org"

# ── JWT ──
JWT_SECRET=<generar-con-openssl-rand-base64-64>
JWT_REFRESH_SECRET=<generar-con-openssl-rand-base64-64>

# ── Correo (recuperación de contraseña) ──────────────────────────────────
# Proveedor de correo para enviar el código de recuperación.
# Valores: "resend" | "smtp" | "none" (por defecto: "none").
# Con "none" el backend imprime un aviso al iniciar y los endpoints de
# recuperación (/api/v1/auth/forgot-password) responden 500.
EMAIL_PROVIDER=none

# Remitente con el que llega el correo al usuario.
EMAIL_FROM=no-reply@codepanel.local

# ── Resend ──────────────────────────────────────────────────────────────
# Solo se usa si EMAIL_PROVIDER=resend. API key en https://resend.com/api-keys
# RESEND_API_KEY=<tu-api-key-de-resend>

# ── SMTP nativo ─────────────────────────────────────────────────────────
# Solo se usan si EMAIL_PROVIDER=smtp.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# SMTP_SECURE=false   # true para puerto 465 (TLS directo); false para 587 (STARTTLS)

# Minutos de validez del código de recuperación.
RESET_CODE_TTL_MINUTES=15

# ── Plantillas de correo ─────────────────────────────────────────────────
# Carpeta con los archivos de plantilla (subject.txt, body.txt, body.html).
# Por defecto se resuelve a <raíz del proyecto>/templates/mail.
# Útil si montas templates/ en otra ruta (ej. volumen de Docker).
# MAIL_TEMPLATES_DIR=/app/templates/mail

# ── Motor de ejecución (sandbox Docker) ─────────────────────────────────
# Todos los valores tienen default en el backend; descomenta solo si
# necesitas ajustarlos sin recompilar.
# EXECUTION_MEMORY_MB=128             # Límite de memoria por contenedor (MB)
# EXECUTION_CPU_QUOTA=50000           # Cuota de CPU (50000 ≈ 50% de un core)
# EXECUTION_PIDS_LIMIT=30             # Límite de procesos por contenedor
# EXECUTION_TIMEOUT_MS=10000          # Timeout de ejecución (ms)
# EXECUTION_AUTO_REMOVE=true          # Docker limpia el contenedor al salir
# EXECUTION_READONLY_ROOTFS=true      # Filesystem raíz del contenedor de solo lectura
# EXECUTION_NO_NEW_PRIVILEGES=true    # Bloquea elevación de privilegios en el contenedor
# EXECUTION_MAX_CONCURRENCY=5         # Máx. contenedores corriendo en paralelo
# EXECUTION_QUEUE_TIMEOUT_MS=30000    # Timeout de espera en cola antes de responder 429 (ms)
# MAX_REQUEST_BODY=1mb                # Límite global del body JSON (express.json)
# EXECUTION_MAX_CODE_BYTES=262144     # Máx. bytes decodificados por código/archivo (256 KB)
# EXECUTION_MAX_STDIN_BYTES=65536     # Máx. bytes decodificados de stdin (64 KB)

# ── Puerto del backend ──
PORT=5555
NODE_ENV=production

# ── Base de datos (PostgreSQL dentro del compose) ──
POSTGRES_USER=code_panel
POSTGRES_PASSWORD=<generar-con-openssl-rand-base64-32>
POSTGRES_DB=code_panel
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db_postgres:5432/${POSTGRES_DB}"

# ── CORS ──
CORS_ORIGINS="https://codepanel.orchfr.duckdns.org"

# ── JWT ──
JWT_SECRET=<generar-con-openssl-rand-base64-64>
JWT_REFRESH_SECRET=<generar-con-openssl-rand-base64-64>

# ── Correo (recuperación de contraseña) ──────────────────────────────────
# Proveedor de correo para enviar el código de recuperación.
# Valores: "resend" | "smtp" | "none" (por defecto: "none").
# Con "none" el backend imprime un aviso al iniciar y los endpoints de
# recuperación (/api/v1/auth/forgot-password) responden 500.
EMAIL_PROVIDER=none

# Remitente con el que llega el correo al usuario.
EMAIL_FROM=no-reply@codepanel.local

# ── Resend ──────────────────────────────────────────────────────────────
# Solo se usa si EMAIL_PROVIDER=resend. API key en https://resend.com/api-keys
# RESEND_API_KEY=<tu-api-key-de-resend>

# ── SMTP nativo ─────────────────────────────────────────────────────────
# Solo se usan si EMAIL_PROVIDER=smtp.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password
# SMTP_SECURE=false   # true para puerto 465 (TLS directo); false para 587 (STARTTLS)

# Minutos de validez del código de recuperación.
RESET_CODE_TTL_MINUTES=15
